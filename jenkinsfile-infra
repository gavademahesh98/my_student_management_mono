pipeline{
    agent{
        label 'worker1'
    }
    tools{
        terraform 'tf'
    }
    environment{
        aws_cred=credentials('aws-cred')
    }
    stages{
        stage('checkout'){
            steps{
            git branch: 'master' , url: 'https://github.com/gavademahesh98/student-management.git'
            echo "clonning is successful"
            }
        }
        stage('terraform-init'){
            steps{
            sh 'terraform init'
            }
        }
        stage('terraform-validate'){
            steps{
                sh 'terraform validate'
            }
        }
        stage('terraform-apply'){
            steps{
                sh 'terraform apply -auto-approve'
            }
        }
    }
}