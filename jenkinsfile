pipeline {
    agent {
        label "worker1"
    }

    tools {
        maven 'mvn'
    }

    stages {
        stage('checkout'){
            steps{
                git 'https://github.com/gavademahesh98/student-management.git'
            }
        }

        stage('build') {
         steps {
        sh '''
            echo "===== JAVA ====="
            which java
            java -version

            echo "===== JAVAC ====="
            which javac
            javac -version

            echo "===== JAVA_HOME ====="
            echo $JAVA_HOME

            echo "===== MAVEN ====="
            which mvn
            mvn -version

            echo "===== BUILD ====="
            mvn clean package
        '''
    }
}
    }
}
