pipeline{
    agent {
        label 'worker1'
    }
    tools{
        maven 'mvn'
    }
    environment{
        AWS_CRED = credentials('aws-cred')
    }
    stages{
        stage('checkout'){
           steps{
             git branch: 'master' , url: 'https://github.com/gavademahesh98/student-management.git'
             echo 'Git Clonning Successfull'
           } 
        }
        stage('build'){
            steps{
                sh 'mvn clean install'
            }
            post{
                success{
                    archiveArtifacts artifacts: 'target/student-management.war' , fingerprint: true
                }
            }
        }
        stage('push artifact to s3'){
            steps{
                sh 'aws s3 cp target/student-management.war s3://student-management-001/student-app/'
            }
        }
        stage('sonar'){
            steps{
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('quality-gates'){
            steps{
                timeout(time:5 , unit: 'MINUTES')
                waitForQualityGate abortPipeline: true
            }
        }
    }

}