pipeline{
    agent{
        label 'worker1'
    }

    tools {
        maven 'maven'
    }
    environment{
        aws_cred=credentials('aws-cred')
        student_service_tag="${BUILD_NUMBER}"
    }
    stages{
        stage('checkout'){
            steps{
            git branch: 'master' , url: 'https://github.com/gavademahesh98/my_student_management_mono.git'
            echo "clonning is successful"
            }
        }
        stage('maven-build'){
            steps{
                sh 'mvn clean package'
            }
            post{
                success{
                    archiveArtifacts artifacts: 'target/student-management.war' , fingerprint: true
                }
            }
        }
        stage('sonar-scan'){
            steps{
                withSonarQubeEnv('sonar-server'){
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('quality-gate'){
            steps{
                timeout(time: 5 , unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
            post {
                failure {
                    script {

                        def sonarProperties = readProperties file: 'target/sonar/report-task.txt'

                        def sonarIssuesUrl =
                            "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                        emailext(
                            subject: "SonarQube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                            body: """
                                <p>SonarQube Quality Gate failed.</p>

                                <p>
                                    <a href="${sonarIssuesUrl}">
                                        <b>View SonarQube Issues Report</b>
                                    </a>
                                </p>
                            """,

                            mimeType: 'text/html',

                            to: 'gavademahesh98@gmail.com'
                        )
                    }
                }
            }

        }
        stage('build-to-s3'){
            steps{
                sh 'aws s3 cp target/student-management.war  s3://student-management-98/student-service/'
            }
        }
        stage('docker-build'){
            steps{
                sh 'docker build --no-cache -t student-service .'
            }
        }

        stage('image-push-ECR'){
            steps{
                sh '''
                aws ecr get-login-password --region ap-southeast-1 | docker login --username AWS --password-stdin 655887417250.dkr.ecr.ap-southeast-1.amazonaws.com
                docker tag student-service:latest 655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/student-service:${student_service_tag}
                docker tag student-service:latest 655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/student-service:latest
                docker push 655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/student-service:${student_service_tag}
                docker push 655887417250.dkr.ecr.ap-southeast-1.amazonaws.com/student-service:latest
                '''
            }
        }
        stage('deployment-on-k8s'){
            steps{
                sh '''
                    aws eks update-kubeconfig --name my-eks-cluster --region ap-southeast-1
                    kubectl apply -f k8s/
                    kubectl get pod
                    sleep 30
                    kubectl get pod
                    kubectl get svc -o wide

                '''
            }
        }

        
    }
}