pipeline {
    agent {
        label "worker1"
    }

    tools {
        maven 'mvn'
    }

    stages {
        stage('checkout'){
            steps{
                git 'https://github.com/gavademahesh98/student-management.git'
                echo "Clonning is Successful"
            }
        }

        stage('build') {
         steps {
            sh '''
                mvn clean package

            '''
         }
             post {
                success {
                      archiveArtifacts artifacts: 'target/student-management.war' , fingerprint: true
                }
            }
        }

        stage ('artifacts to s3'){
            steps{
                sh 'aws s3 cp target/student-management.war s3://student-management-001/student-app/'
            }
        }
    }
}
