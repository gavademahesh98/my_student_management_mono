pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'mvn'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages{

        stage('Checkout'){
            steps{
                git 'https://github.com/mayurpandit25/student-management.git'
                echo "Clonning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                  mvn clean package
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3') {
            steps {
                sh 'aws s3 cp target/*.war s3://mayurcbz.space/Artifacts/student.war'
            }
        }
    }
}