pipeline {
    agent {
        label 'worker1'
    }

    tools {
        maven 'maven'
    }

    environment {
        AWS_CRED = credentials('aws-cred')
    }

    stages {

        stage('checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/gavademahesh98/student-management.git'
                echo 'clonning is done'
            }
        }

        stage('build war package') {
            steps {
                sh '''
                mvn clean package
                '''
            }

            post {
                success {
                    archiveArtifacts artifacts: 'target/student-management.war', fingerprint: true
                }
            }
        }

        stage('code-scan') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('quality-gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }

            post {
                failure {
                    script {

                        def sonarProperties = readProperties file: 'target/sonar/report-task.txt'

                        def sonarIssuesUrl =
                            "${sonarProperties.serverUrl}/project/issues?id=${URLEncoder.encode(sonarProperties.projectKey, 'UTF-8')}"

                        emailext(
                            subject: "SonarQube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                            body: """
                                <p>SonarQube Quality Gate failed.</p>

                                <p>
                                    <a href="${sonarIssuesUrl}">
                                        <b>View SonarQube Issues Report</b>
                                    </a>
                                </p>
                            """,

                            mimeType: 'text/html',

                            to: 'gavademahesh98@gmail.com'
                        )
                    }
                }
            }
        }

        stage('push-artifact-s3') {
            steps {
                sh 'aws s3 cp target/student-management.war s3://student-management-98/student-service/'
            }
        }
    }
}

